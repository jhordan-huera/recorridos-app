# URL base de la API. SIN sufijo /api: el backend monta sus rutas en la raíz
# (/auth, /ninos, /vehiculos, /recorridos).
#
# En local el backend escucha en el 3001, porque el 3000 lo ocupa el dev server
# de este proyecto (ver vite.config.js).
#
# El valor de producción NO se pone aquí: vive en .env.production, que Vite carga
# solo al compilar. `npm run dev` usa este fichero (backend local) y
# `npm run build` usa aquel (backend desplegado), sin editar nada a mano.
#
# Si alguna vez quieres desarrollar contra el backend desplegado, crea un
# .env.local con la URL: tiene prioridad sobre .env y no se versiona.
VITE_API_URL=http://localhost:3001

# Sentry (opcional)
VITE_SENTRY_DSN=

# NOTA: VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY están declaradas en .env pero
# el código no usa el cliente de Supabase en ningún sitio: la app habla solo con
# la API de Express. La dependencia @supabase/supabase-js también está sin usar.
# Se pueden retirar las tres cosas.
